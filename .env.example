# ===========================================
# XBot Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# ===========================================
# AI Provider API Keys
# ===========================================

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
GOOGLE_AI_API_KEY=

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# App Configuration
# ===========================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# ===========================================
# Security
# ===========================================

# Encryption key for session data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# ===========================================
# Optional Features
# ===========================================

# Enable debug mode
DEBUG=false

# Rate limiting (tweets per hour)
RATE_LIMIT_TWEETS_PER_HOUR=10
